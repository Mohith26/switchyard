{
  "name": "edge",
  "listen": "127.0.0.1:8080",
  "cache_nodes": ["127.0.0.1:9001", "127.0.0.1:9002", "127.0.0.1:9003"],
  "hashing": "ring",
  "vnodes": 160,
  "health_path": "/healthz",
  "health_interval": "250ms",
  "failover": true,
  "request_timeout": "1s",
  "rate_limit": { "rps": 500, "burst": 250, "header": "X-Client-ID" },
  "shedding": { "initial": 64, "min": 8, "max": 2000, "window": "100ms" }
}
